# Базовый путь Go API, без завершающего слэша. Клиент дописывает к нему /categories, /words и т.д.
#
# Локально (frontend/.env.development, команда next dev):
#   NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
#
# Прод (frontend/.env.production, команда next build / Vercel).
# Хост: https://qaztil.onrender.com/
#   NEXT_PUBLIC_API_URL=https://qaztil.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
